# Copy to .env next to the compose files. NEVER commit the real .env.
#   cp .env.example .env

# Hugging Face token - only needed for gated repos (Llama, Gemma, Mistral).
# Create at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- vLLM ---------------------------------------------------------------
# Defaults are tuned for a 16 GB Ada card. See docs/ai-stack.md.
MODEL=Qwen/Qwen3-8B
SERVED_NAME=local
QUANT=fp8
MAX_LEN=12288
GPU_UTIL=0.80

# --- fine-tuning --------------------------------------------------------
WORKSPACE=./workspace
WANDB_API_KEY=
