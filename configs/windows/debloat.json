    },
    {
      "Name": "DisableEdgeAds",
      "Value": true,
      "Group": "privacy"
    },
    {
      "Name": "DisableFindMyDevice",
      "Value": true,
      "Group": "privacy"
    },
    {
      "Name": "DisableCopilot",
      "Value": true,
      "Group": "ai"
    },
    {
