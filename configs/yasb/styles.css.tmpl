/* ==========================================================================
   yasb - Tokyo Night
   --------------------------------------------------------------------------
   Palette copied verbatim from omacom/omarchy themes/tokyo-night/colors.toml
   so the bar, the komorebi borders and Alacritty agree:

     background        {{background}}      foreground        {{foreground}}
     lighter_bg        {{lighter_background}}      bright_foreground {{bright_foreground}}
     selection         {{selection}}      dark_foreground   {{dark_foreground}}
     muted             {{muted}}      accent / blue     {{accent}}
     red     {{red}}   yellow {{yellow}}   green  {{green}}
     magenta {{bright_magenta}}   cyan   {{bright_cyan}}   orange {{bright_yellow}}

   This is PyQt6 QSS, not a browser. No flexbox, no CSS variables, no
   descendant selectors beyond what Qt supports. Colours are therefore
   repeated literally - change them with find/replace.
   ========================================================================== */

/* FONT FAMILY NAME, not the package name.
   winget's DEVCOM.JetBrainsMonoNerdFont installs files called
   JetBrainsMonoNerdFont-*.ttf, but the family registers as "JetBrainsMono NF".
   "JetBrainsMono Nerd Font" does not exist; asking for it falls back to a font
   with no icon glyphs, which is why every icon rendered as tofu or as a random
   letter, and why icons overlapped their labels (wrong advance widths).
   The list below covers the common Nerd Font packages, in preference order. */
* {
    font-family: "JetBrainsMono NF", "JetBrainsMonoNL NF", "CaskaydiaCove NF",
                 "UbuntuMono Nerd Font", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: {{foreground}};
}

.yasb-bar {
    background-color: {{background}};
    padding: 0;
    margin: 0;
}

.widget {
    padding: 0 7px;
    margin: 0;
}

.widget .label {
    padding: 0 1px;
}

.widget .label.alt {
    color: {{bright_foreground}};
}

/* ICON CLIPPING - use min-width, NOT padding.

   yasb puts every <span> in its own QLabel (core/widgets/base.py), sized from
   the font's ADVANCE width for that glyph. Nerd Font icons routinely draw INK
   wider than their advance, and Qt clips a QLabel's text to its CONTENT rect.
   Padding sits outside the content rect, so adding padding widens the widget
   but changes nothing about the clipping - tested with 30px of padding and the
   CPU, RAM, speaker and bluetooth glyphs were still sheared.

   min-width enlarges the content rect. Note that Qt treats it as the MINIMUM
   WIDGET width, so the usable content is min-width MINUS padding. Measured ink
   at this font size tops out at 17px (the speaker at 100% volume), and 22px
   minus 8px of padding left only 14px - which is why the outermost sound wave
   and the edge of the bluetooth rune were still being shaved off.
   30px leaves ~22px of content and clears every glyph on the bar. */
.widget .icon {
    font-size: 14px;
    color: {{accent}};
    min-width: 30px;
    padding-left: 2px;
    padding-right: 6px;
}

/* Icon-only widgets need no gap before a value, but still need the width. */
.bluetooth-widget .icon,
.wifi-widget .icon,
.omacheese-menu-widget .icon {
    min-width: 28px;
    padding-left: 3px;
    padding-right: 3px;
}

/* --------------------------------------------------------------------------
   Left: the Omacheese menu launcher
   -------------------------------------------------------------------------- */

.omacheese-menu-widget {
    padding: 0 10px 0 6px;
}

.omacheese-menu-widget .label {
    font-size: 16px;
    color: {{accent}};
}

.omacheese-menu-widget:hover .label {
    color: {{bright_magenta}};
}

/* --------------------------------------------------------------------------
   Workspaces - the Omarchy dot row
   Empty and populated render as dots; the focused one expands to its name.
   -------------------------------------------------------------------------- */

.komorebi-workspaces {
    padding: 0 4px;
}

.komorebi-workspaces .widget-container {
    background-color: transparent;
    margin: 0;
}

.komorebi-workspaces .ws-btn {
    font-size: 11px;
    min-width: 14px;
    color: {{muted}};
    background-color: transparent;
    margin: 0;
    padding: 0 4px;
    border-radius: 10px;
}

.komorebi-workspaces .ws-btn.populated {
    color: {{accent}};
}

.komorebi-workspaces .ws-btn.active {
    font-size: 12px;
    font-weight: 600;
    color: {{background}};
    background-color: {{accent}};
    padding: 0 10px;
}

.komorebi-workspaces .ws-btn:hover {
    color: {{bright_foreground}};
    background-color: {{selection}};
}

.komorebi-workspaces .ws-btn.active:hover {
    color: {{background}};
    background-color: {{bright_blue}};
}

.komorebi-workspaces .offline-status {
    color: {{dark_foreground}};
    padding: 0 6px;
}

/* --------------------------------------------------------------------------
   Active layout + focused window title
   -------------------------------------------------------------------------- */

/* The layout glyph was both small and sheared. It is a single icon with no
   text beside it, so it needs its own size bump and enough horizontal padding
   to clear the ink overhang described above. */
.komorebi-active-layout {
    padding: 0 6px;
}

.komorebi-active-layout .label {
    font-size: 17px;
    color: {{bright_magenta}};
    /* Lone icon rendered as .label, so it needs min-width too - see the note
       on icon clipping above. Scaled to the larger font-size. */
    min-width: 32px;
    padding: 0 4px;
}

.komorebi-active-layout .widget-container:hover {
    background-color: {{selection}};
    border-radius: 8px;
}

.komorebi-layout-menu .menu-item {
    background-color: {{background}};
    color: {{foreground}};
    padding: 6px 14px;
}

.komorebi-layout-menu .menu-item:hover {
    background-color: {{selection}};
    color: {{bright_foreground}};
}

.active-window-widget {
    padding: 0 10px;
}

.active-window-widget .label {
    color: {{dark_foreground}};
    font-weight: 400;
}

/* --------------------------------------------------------------------------
   Center: clock
   -------------------------------------------------------------------------- */

.clock-widget .label {
    color: {{bright_foreground}};
    font-weight: 600;
    font-size: 13px;
}

/* --------------------------------------------------------------------------
   Right: system readouts
   -------------------------------------------------------------------------- */

.cpu-widget .label       { color: {{green}}; }
.memory-widget .label    { color: {{yellow}}; }
.volume-widget .label    { color: {{bright_cyan}}; }
.wifi-widget .label      { color: {{accent}}; }
.bluetooth-widget .label { color: {{accent}}; }
.battery-widget .label   { color: {{green}}; }

/* --------------------------------------------------------------------------
   Bluetooth popup
   --------------------------------------------------------------------------
   Class names taken from src/core/widgets/services/bluetooth/bluetooth_widgets.py,
   not guessed: .bluetooth-menu .bluetooth-list .bluetooth-item .section
   .section-title .header .footer .name .status .icon .battery .power-button
   .scan-icon .settings-button .controls-container .details-container.
   An earlier version styled ".device", which does not exist here - so the
   popup fell back to Qt defaults and looked cramped and unstyled.

   yasb's popup device icons are Segoe Fluent Icons, not Nerd Font (its own
   docs say so), and the global JetBrainsMono rule above was overriding them.
   -------------------------------------------------------------------------- */

.bluetooth-menu {
    background-color: {{background}};
    border: 1px solid {{selection}};
    border-radius: 12px;
    min-width: 340px;

    /* POPUP HEIGHT - tune here.
       Room for about three and a half rows: ~44px header + 3.5 x 44px rows
       + ~50px footer.

       This belongs on the POPUP, not on .bluetooth-list. The list is a frame
       inside a scroll area, and forcing a height there squeezed the rows
       instead of lengthening the popup. bluetooth_widgets.py adds the list
       with stretch 1, so height given to the popup lands on the list and the
       rows keep their natural size.

       Delete this line to let the popup size itself to its contents again. */
    min-height: 260px;
}

.bluetooth-menu .header {
    color: {{bright_foreground}};
    font-size: 14px;
    font-weight: 600;
    padding: 14px 16px 10px 16px;
}

.bluetooth-menu .title {
    color: {{bright_foreground}};
    font-size: 14px;
    font-weight: 600;
}

/* This is what gives the list its sections instead of one flat run. */
.bluetooth-menu .section {
    padding: 6px 0;
}

.bluetooth-menu .section-title {
    color: {{accent}};
    font-size: 11px;
    font-weight: 600;
    padding: 10px 16px 6px 16px;
}

.bluetooth-menu .bluetooth-list {
    background-color: transparent;
    padding: 0 8px 8px 8px;
}

/* No min-height here. Setting one on rows inside a Qt layout that is already
   sizing them makes the rows overlap - the layout reserves one height and the
   stylesheet paints another. Padding alone gives the spacing. */
.bluetooth-menu .bluetooth-item {
    background-color: transparent;
    border-radius: 8px;
    padding: 10px 12px;
    margin: 2px 0;
}

.bluetooth-menu .bluetooth-item:hover {
    background-color: {{selection}};
}

.bluetooth-menu .name {
    color: {{bright_foreground}};
    font-size: 13px;
}

.bluetooth-menu .status {
    color: {{dark_foreground}};
    font-size: 11px;
}

/* Device and battery glyphs are labels inside a row. */
.bluetooth-menu .icon,
.bluetooth-menu .battery-icon {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", "JetBrainsMono NF";
    font-size: 17px;
    color: {{accent}};
    min-width: 28px;
    padding: 0 6px 0 2px;
}

.bluetooth-menu .battery {
    color: {{green}};
    font-size: 11px;
}

/* One rule for every button in the popup. They were declared separately with
   different padding, which is why they came out different sizes. */
.bluetooth-menu .connect,
.bluetooth-menu .settings-button,
.bluetooth-menu .power-button {
    background-color: {{lighter_background}};
    color: {{bright_foreground}};
    border: 1px solid {{selection}};
    border-radius: 6px;
    padding: 0 14px;
    margin: 0;
    font-size: 12px;
    min-width: 88px;
    min-height: 30px;
}

/* The refresh control is a QPushButton too, not a label - it was picking up
   the label-icon rule and rendering as a bare glyph beside a full pill. Same
   height as the settings button, square, so the footer reads as a pair. */
.bluetooth-menu .scan-icon {
    font-family: "Segoe Fluent Icons", "Segoe MDL2 Assets", "JetBrainsMono NF";
    font-size: 15px;
    color: {{accent}};
    background-color: {{lighter_background}};
    border: 1px solid {{selection}};
    border-radius: 6px;
    padding: 0;
    margin: 0;
    min-width: 30px;
    max-width: 30px;
    min-height: 30px;
}

.bluetooth-menu .connect:hover,
.bluetooth-menu .settings-button:hover,
.bluetooth-menu .power-button:hover,
.bluetooth-menu .scan-icon:hover {
    background-color: {{selection}};
    border: 1px solid {{accent}};
}

.bluetooth-menu .footer {
    border-top: 1px solid {{selection}};
    padding: 10px 16px;
}

.bluetooth-menu .error-message {
    color: {{red}};
    font-size: 12px;
    padding: 8px 16px;
}

.bluetooth-menu .controls-container,
.bluetooth-menu .details-container {
    background-color: transparent;
}

/* --------------------------------------------------------------------------
   Volume popup
   -------------------------------------------------------------------------- */

.audio-menu {
    background-color: {{background}};
    border: 1px solid {{selection}};
    border-radius: 12px;
    min-width: 300px;
}

.audio-menu .header {
    color: {{bright_foreground}};
    font-size: 14px;
    font-weight: 600;
    padding: 14px 16px 10px 16px;
}

.audio-menu .device {
    color: {{foreground}};
    background-color: transparent;
    border: none;
    border-radius: 8px;
    padding: 9px 12px;
    font-size: 13px;
}

.audio-menu .device:hover {
    background-color: {{selection}};
    color: {{bright_foreground}};
}

.audio-menu .device.selected {
    color: {{green}};
}

/* A QSlider draws nothing but its sub-controls, so without ::groove and
   ::handle rules Qt paints the stock Windows slider - which is what made it
   look oversized and crude next to the rest of the popup. */
.audio-menu .volume-slider {
    padding: 10px 16px 16px 16px;
    min-height: 20px;
}

.audio-menu .volume-slider::groove:horizontal {
    background-color: {{selection}};
    height: 4px;
    border-radius: 2px;
}

.audio-menu .volume-slider::sub-page:horizontal {
    background-color: {{accent}};
    height: 4px;
    border-radius: 2px;
}

.audio-menu .volume-slider::add-page:horizontal {
    background-color: {{selection}};
    height: 4px;
    border-radius: 2px;
}

.audio-menu .volume-slider::handle:horizontal {
    background-color: {{bright_foreground}};
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

.audio-menu .volume-slider::handle:horizontal:hover {
    background-color: {{bright_foreground}};
}

.audio-menu .system-volume-container,
.audio-menu .apps-container,
.audio-menu .audio-container {
    background-color: transparent;
}

/* Last widget on the bar: needs room on BOTH sides, the right one so the bar
   edge does not shear the glyph, the left so it does not crowd the neighbour. */
.power-menu-widget {
    padding: 0 4px 0 8px;
}

.power-menu-widget .label {
    color: {{red}};
    font-size: 15px;
    min-width: 28px;
    padding-left: 2px;
    padding-right: 2px;
}

.power-menu-widget:hover .label {
    color: {{bright_red}};
}

/* --------------------------------------------------------------------------
   Power menu popup
   --------------------------------------------------------------------------
   Real classes from src/core/widgets/yasb/power_menu.py:
   .power-menu-overlay (the dimmed backdrop), .power-menu-popup, .buttons
   (the frame), .button plus a per-action class (.button.lock, .button.signout,
   ...), .button .icon, .button .label, .uptime.
   The overlay and .buttons were missing before, which is why the popup came
   out small and unstyled.
   -------------------------------------------------------------------------- */

.power-menu-overlay {
    background-color: rgba(13, 14, 20, 0.6);
}

.power-menu-popup {
    background-color: {{background}};
    border: 1px solid {{selection}};
    border-radius: 16px;
    padding: 8px;
}

.power-menu-popup .buttons {
    background-color: transparent;
    padding: 10px;
}

.power-menu-popup .button {
    background-color: {{lighter_background}};
    border: 1px solid {{selection}};
    border-radius: 12px;
    padding: 18px 10px;
    margin: 7px;
    min-width: 140px;
    min-height: 120px;
}

.power-menu-popup .button:hover {
    background-color: {{selection}};
    border: 1px solid {{accent}};
}

.power-menu-popup .button .icon {
    font-size: 40px;
    color: {{accent}};
    min-width: 56px;
    padding: 0;
    margin-bottom: 8px;
}

.power-menu-popup .button .label {
    color: {{bright_foreground}};
    font-size: 13px;
    font-weight: 500;
    padding: 0;
}

/* Colour the destructive actions so they are not one undifferentiated grid. */
.power-menu-popup .button.shutdown .icon { color: {{red}}; }
.power-menu-popup .button.restart .icon  { color: {{bright_yellow}}; }
.power-menu-popup .button.lock .icon     { color: {{green}}; }
.power-menu-popup .button.sleep .icon    { color: {{bright_magenta}}; }
.power-menu-popup .button.cancel .icon   { color: {{dark_foreground}}; }

.power-menu-popup .button.shutdown:hover { border: 1px solid {{red}}; }
.power-menu-popup .button.restart:hover  { border: 1px solid {{bright_yellow}}; }

.power-menu-popup .uptime {
    color: {{dark_foreground}};
    font-size: 12px;
    padding: 6px 0 12px 0;
}

/* --------------------------------------------------------------------------
   Shared chrome
   -------------------------------------------------------------------------- */

.context-menu {
    background-color: {{background}};
    border: 1px solid {{selection}};
    border-radius: 8px;
}

.tooltip {
    background-color: {{lighter_background}};
    color: {{bright_foreground}};
    border: 1px solid {{muted}};
    border-radius: 6px;
    padding: 4px 8px;
}
